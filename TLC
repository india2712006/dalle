module traffic_light(
    input clk,
    input rst,
    input farm_car,

    output reg r1,
    output reg y1,
    output reg g1,

    output reg r2,
    output reg y2,
    output reg g2
);

 
    reg [1:0] state;

   
    reg [31:0] count;
   
       localparam S0 = 2'b00;
    localparam S1 = 2'b01;
    localparam S2 = 2'b10;
    localparam S3 = 2'b11;

    always @(posedge clk or posedge rst)
    begin
        if (rst)
        begin
            state <= S0;
            count <= 0;
        end

        else
        begin
            case(state)

                S0:
                begin
                    if (farm_car)
                    begin
                        state <= S2;
                        count <= 0;
                    end
                    else if (count < 50_000_000)
                    begin
                        count <= count + 1;
                    end
                    else
                    begin
                        count <= 0;
                        state <= S1;
                    end
                end

         
                S1:
                begin
                    if (count < 5_000_000)
                    begin
                        count <= count + 1;
                    end
                    else
                    begin
                        count <= 0;
                        state <= S2;
                    end
                end

             
                S2:
                begin
                    if (count < 50_000_000)
                    begin
                        count <= count + 1;
                    end
                    else
                    begin
                        count <= 0;
                        state <= S3;
                    end
                end

                S3:
                begin
                    if (count < 5_000_000)
                    begin
                        count <= count + 1;
                    end
                    else
                    begin
                        count <= 0;
                        state <= S0;
                    end
                end

                default:
                begin
                    state <= S0;
                    count <= 0;
                end

            endcase
        end
    end



    always @(*)
    begin

     
        r1 = 0;
        y1 = 0;
        g1 = 0;

        r2 = 0;
        y2 = 0;
        g2 = 0;

        case(state)

            // Road 1 GREEN
            S0:
            begin
                r1 = 0;
                y1 = 0;
                g1 = 1;

                r2 = 1;
                y2 = 0;
                g2 = 0;
            end

            // Road 1 YELLOW
            S1:
            begin
                r1 = 0;
                y1 = 1;
                g1 = 0;

                r2 = 1;
                y2 = 0;
                g2 = 0;
            end

            // Road 2 GREEN
            S2:
            begin
                r1 = 1;
                y1 = 0;
                g1 = 0;

                r2 = 0;
                y2 = 0;
                g2 = 1;
            end

            // Road 2 YELLOW
            S3:
            begin
                r1 = 1;
                y1 = 0;
                g1 = 0;

                r2 = 0;
                y2 = 1;
                g2 = 0;
            end

        endcase
    end

endmodule

