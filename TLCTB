module traffic_light_tb;

 
    reg clk;
    reg rst;
    reg farm_car;

   
    wire r1;
    wire y1;
    wire g1;

    wire r2;
    wire y2;
    wire g2;

    traffic_light uut (
        .clk(clk),
        .rst(rst),
        .farm_car(farm_car),

        .r1(r1),
        .y1(y1),
        .g1(g1),

        .r2(r2),
        .y2(y2),
        .g2(g2)
    );


    always #5 clk = ~clk;

    initial begin

       
        clk = 0;
        rst = 1;
        farm_car = 0;

        #20;
        rst = 0;

        #550;

     
        farm_car = 1;

        #20;

        farm_car = 0;

        #550;

 
        $finish;
    end

    initial begin
        $monitor(
            "Time=%0t | rst=%b farm_car=%b | state=%b | R1=%b Y1=%b G1=%b | R2=%b Y2=%b G2=%b",
            $time,
            rst,
            farm_car,
            uut.state,
            r1, y1, g1,
            r2, y2, g2
        );
    end

endmodule
