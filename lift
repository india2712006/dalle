
module lift_controller (
    input clk,
    input reset,
    input [1:0] request_floor,
    output reg [1:0] Y,
    output reg door,
    output reg stop,
    output reg up,
    output reg down
);

always @(posedge clk or posedge reset)
begin
    if (reset)
    begin
        Y <= 2'b00;
    end
    else
    begin
        if (Y < request_floor)
            Y <= Y + 1'b1;
        else if (Y > request_floor)
            Y <= Y - 1'b1;
        else
            Y <= Y;
    end
end

always @(*)
begin
    if (Y == request_floor)
    begin
        stop = 1;
        door = 1;
        up = 0;
        down = 0;
    end
    else if (Y < request_floor)
    begin
        stop = 0;
        door = 0;
        up = 1;
        down = 0;
    end
    else
    begin
        stop = 0;
        door = 0;
        up = 0;
        down = 1;
    end
end

endmodule
